{
  "name": "source-exporter",
  "version": "1.2.0",
  "private": true,
  "description": "An extension to help exporting and reconstructing source files from source maps",
  "scripts": {
    "clean": "node scripts/build.js --clean",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,scripts}/**/*.{js,json,html,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"{src,scripts}/**/*.{js,json,html,css}\" \"*.{js,json,md}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "monaco-editor": "0.52.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "js-beautify": "^1.15.4"
  }
}
