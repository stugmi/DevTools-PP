{
  "name": "devtools-plus-plus",
  "version": "1.5.3",
  "private": true,
  "description": "An extension to help exporting and reconstructing source files from source maps",
  "scripts": {
    "clean": "bun scripts/build.js --clean",
    "build": "bun scripts/build.js",
    "dev": "bun scripts/dev/dev.js",
    "screenshots": "bun scripts/screenshots/screenshots.js",
    "typecheck": "bun run --bun tsc --noEmit",
    "typecheck:watch": "bun run --bun tsc --noEmit --watch",
    "test": "bun test ./tests/test-*.js",
    "lint": "bun lint --no-script .",
    "lint:fix": "bun lint --no-script . --fix",
    "format": "bun fmt --no-script \"{src,scripts,tests}/**/*.{js,json,html,css}\" \"*.{js,json,md,toml}\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "format:check": "bun fmt --no-script --check \"{src,scripts,tests}/**/*.{js,json,html,css}\" \"*.{js,json,md,toml}\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run build",
    "fix": "bun run lint:fix && bun run format && bun run build",
    "hooks:install": "git config core.hooksPath .githooks",
    "secrets:install": "bun scripts/secrets/betterleaks.js install",
    "secrets": "bun scripts/secrets/betterleaks.js history"
  },
  "packageManager": "bun@1.4.4-canary.20261105.1",
  "trustedDependencies": [
    "bun"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.0.287",
    "bun": "1.4.4-canary.20261105.1",
    "crx3": "2.0.0",
    "globals": "^15.14.0",
    "monaco-editor": "0.52.2",
    "pbf": "4.0.2",
    "playwright": "1.65.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "js-beautify": "^1.15.4",
    "jszip": "3.10.1"
  },
  "patchedDependencies": {
    "monaco-editor@0.52.2": "patches/monaco-editor@0.52.2.patch"
  }
}
