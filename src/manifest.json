{
  "manifest_version": 3,
  "name": "DevTools++",
  "version": "1.5.3",
  "description": "An alternative source and network workspace inside Chrome DevTools for debugging, reverse engineering, and inspecting web pages.",
  "host_permissions": ["<all_urls>"],
  "permissions": ["clipboardWrite"],
  "devtools_page": "devtools/devtools.html",
  "action": {
    "default_popup": "panel/popup.html",
    "default_title": "DevTools++"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; worker-src 'self'; object-src 'self'"
  }
}
