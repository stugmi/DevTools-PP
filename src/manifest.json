{
  "manifest_version": 3,
  "name": "Source Exporter",
  "version": "1.2.2",
  "description": "Export reconstructed source files from DevTools source maps as ZIP or TAR archives",
  "host_permissions": ["<all_urls>"],
  "permissions": ["clipboardWrite", "clipboardRead", "offscreen"],
  "devtools_page": "devtools/devtools.html",
  "action": {
    "default_popup": "panel/popup.html",
    "default_title": "Source Exporter"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; worker-src 'self'; object-src 'self'"
  }
}
